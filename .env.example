# NexBridge Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider ──────────────────────────────────────────────────────────────

# Default: Anthropic Claude API
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local Ollama (development, no API key needed)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2

# ── Registry ──────────────────────────────────────────────────────────────────

# Optional: path to a folder of registry JSON files for multi-registry support
# REGISTRY_DIR=./registries
